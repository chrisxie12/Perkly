# Copy to .env.local and fill in. Never commit .env.local.
# Full guide: docs/SUPABASE_SETUP.md (section 5).

# STAGING values only on laptops and Vercel Preview/Development.
# Production values go only in Vercel's Production environment (roadmap step 1.9).

# Supabase → Project Settings → API Keys. e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE key (sb_publishable_...). Never the secret key (sb_secret_...):
# NEXT_PUBLIC_ values ship to the browser, and the app refuses a secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of this deployment (metadata, sitemap). Leave unset on Vercel previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Not needed yet. Server-only, added at roadmap step 1.7 (booking emails).
# Sign-in emails use the Resend key stored in the Supabase dashboard's SMTP settings.
# RESEND_API_KEY=
