# Copy to .env.local and fill in. Never commit .env.local.
# Find both values in Supabase → Project Settings → API Keys.

# Your project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE key (sb_publishable_...) or the legacy anon key.
# Never put the secret / service-role key here: NEXT_PUBLIC_ values ship to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public URL of this deployment, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
