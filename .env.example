# Copy to .env.local and fill in. Never commit .env.local.
# Full guide: docs/SUPABASE_SETUP.md (section 5).

# STAGING values only on laptops and Vercel Preview/Development.
# Production values go only in Vercel's Production environment (roadmap step 1.9).

# Supabase → Project Settings → API Keys. e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE key (sb_publishable_...). Never the secret key (sb_secret_...):
# NEXT_PUBLIC_ values ship to the browser, and the app refuses a secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of this deployment: links in emails and notifications, QR codes, sitemap.
# When unset, QR codes use the address the page was opened on.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# production | staging | development. Anything but production shows a label on every
# page and keeps search engines out. When unset: Vercel Production → production,
# Vercel Preview → staging, anything else → development.
# NEXT_PUBLIC_APP_ENV=development

# --- Server only. Never prefix these with NEXT_PUBLIC_. All optional. ---
# Sign-in emails don't need these: they use the Resend key in the Supabase dashboard's SMTP settings.
# These three switch on: confirming a student's optional institutional email by code,
# and emailing students when a reviewer decides. Without them both are off and everything else works.
# SUPABASE_SECRET_KEY=          # staging secret key (sb_secret_...), server only
# RESEND_API_KEY=               # re_..., a separate key per environment
# RESEND_FROM_EMAIL=            # e.g. Perqly <no-reply@auth.your-domain>

# Production only: protects the daily job (/api/cron/daily). 32+ random characters.
# CRON_SECRET=
